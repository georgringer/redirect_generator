{
	"name": "georgringer/redirect-generator",
	"type": "typo3-cms-extension",
	"description": "Generate redirect entries from a given set of URLs and export all to CSV",
	"keywords": [
		"TYPO3",
		"extension",
		"redirect",
		"import",
		"export",
		"csv"
	],
	"homepage": "https://ringer.it",
	"authors": [
		{
			"name": "Georg Ringer",
			"role": "Developer",
			"homepage": "https://ringer.it"
		}
	],
	"license": [
		"GPL-2.0-or-later"
	],
	"require": {
		"typo3/cms-core": "^14.3",
		"typo3/cms-redirects": "^14.3"
	},
	"require-dev": {
		"typo3/testing-framework": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"GeorgRinger\\RedirectGenerator\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GeorgRinger\\RedirectGenerator\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"lock": false,
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"extension-key": "redirect_generator",
			"web-dir": ".Build/Web"
		}
	},
	"replace": {
		"typo3-ter/redirect-generator": "self.version"
	},
	"scripts": {
		"post-autoload-dump": [
			"TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
		]
	}
}
